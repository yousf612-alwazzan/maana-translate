<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معنى — التثبيت" Width="800" Height="548"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0E0E0F" Foreground="#EBE6DA" FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Gold" Color="#C8A55A"/>
    <SolidColorBrush x:Key="GoldHi" Color="#E3C783"/>
    <SolidColorBrush x:Key="GoldDim" Color="#7D6A3C"/>
    <SolidColorBrush x:Key="Line" Color="#2C2A26"/>
    <SolidColorBrush x:Key="Panel" Color="#151516"/>
    <SolidColorBrush x:Key="Muted" Color="#9C968A"/>
    <SolidColorBrush x:Key="Text" Color="#EBE6DA"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource GoldDim}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1B1A18"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
                <Setter Property="Foreground" Value="{StaticResource GoldHi}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#23211C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#5D594F"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#33312C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#0E0E0F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource Gold}" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GoldHi}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldHi}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#F6EBC8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#B4934C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#2A2824"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#33312C"/>
                <Setter Property="Foreground" Value="#6A655B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1F1E1B"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0" Height="34">
              <DockPanel>
                <Grid DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Rectangle Stroke="{StaticResource GoldDim}" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="dot" Fill="{StaticResource Gold}" Margin="3" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                  </Rectangle>
                </Grid>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldDim}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldHi}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="P" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="23"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource P}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Key" TargetType="Border">
      <Setter Property="BorderBrush" Value="#4A463E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#1B1A18"/>
      <Setter Property="Padding" Value="7,1"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Mock" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#3A3528" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="60"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Border x:Name="titleBar" Grid.Row="0" Background="#0E0E0F" BorderBrush="{StaticResource GoldDim}" BorderThickness="0,0,0,1">
        <DockPanel Margin="16,0,4,0">
          <Button x:Name="btnClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}" ToolTip="إغلاق">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="btnMin" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}" ToolTip="تصغير">
            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Margin="0,6,0,0"/>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="26" Height="26">
              <Path Data="M0.5,0.5 L18.5,0.5 L25.5,7.5 L25.5,25.5 L0.5,25.5 Z" Stroke="{StaticResource GoldDim}" StrokeThickness="1"/>
              <TextBlock Text="ع" Foreground="{StaticResource Gold}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
            </Grid>
            <TextBlock Text="معنى" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,1"/>
            <TextBlock x:Name="verText" Text="التثبيت" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="10,1,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="188"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- steps rail -->
        <Border Grid.Column="0" Background="#111112" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <StackPanel x:Name="rail" Margin="0,22,0,0"/>
        </Border>

        <!-- pages -->
        <Grid Grid.Column="1" Margin="30,24,30,10">

          <StackPanel x:Name="p0">
            <TextBlock Style="{StaticResource H}" Text="تثبيت إضافة معنى"/>
            <TextBlock Style="{StaticResource P}" Text="البرنامج يحط ملفات الإضافة على جهازك، وبعدها يمشي معك ثلاث خطوات قصيرة داخل المتصفح."/>
            <TextBlock Style="{StaticResource Small}" Text="المتصفح ما يسمح لأي برنامج يضيف إضافة بنفسه، فهالخطوات الثلاث تسويها إنت. كل خطوة ضغطة أو لصق، والبرنامج يجهّز لك اللي تلصقه."/>
            <TextBlock Text="المتصفح اللي تبي تثبّت عليه" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,16,0,8"/>
            <StackPanel x:Name="browserList"/>
            <TextBlock x:Name="noBrowser" Style="{StaticResource Small}" Visibility="Collapsed" Text="ما لقيت متصفح مبني على كروميوم. تقدر تكمل وتفتح متصفحك بنفسك."/>
          </StackPanel>

          <StackPanel x:Name="p1" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H}" Text="نسخ الملفات"/>
            <TextBlock x:Name="copyStatus" Style="{StaticResource P}" Text="جاري النسخ..."/>
            <Border Style="{StaticResource Mock}" Margin="0,6,0,0">
              <TextBlock x:Name="pathText" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource GoldHi}" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Style="{StaticResource Small}" Margin="0,12,0,0" Text="لا تحذف هالمجلد ولا تنقله: المتصفح يقرأ الإضافة منه كل مرة يشتغل."/>
            <TextBlock x:Name="copyError" Style="{StaticResource P}" Foreground="#CF7663" Visibility="Collapsed" Margin="0,10,0,0"/>
          </StackPanel>

          <StackPanel x:Name="p2" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H}" Text="افتح صفحة الإضافات"/>
            <TextBlock Style="{StaticResource P}" Text="١. اضغط «افتح المتصفح»."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="٢. في شريط العنوان اضغط" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Key}" FlowDirection="LeftToRight"><TextBlock Text="Ctrl + V" FontSize="12"/></Border>
              <TextBlock Text="ثم" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Key}" FlowDirection="LeftToRight"><TextBlock Text="Enter" FontSize="12"/></Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Small}" Text="العنوان انّسخ لك جاهز، ما تحتاج تكتبه."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="btnOpenBrowser" Style="{StaticResource BtnPrimary}" Content="افتح المتصفح"/>
              <Button x:Name="btnCopyUrl" Style="{StaticResource Btn}" Content="انسخ العنوان مرة ثانية" Margin="8,0,0,0"/>
              <TextBlock x:Name="copied2" Text="انّسخ" Foreground="#8FB184" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Hidden"/>
            </StackPanel>
            <Border Style="{StaticResource Mock}" Margin="0,18,0,0">
              <Border Background="#232325" CornerRadius="14" Height="30" Padding="12,0">
                <DockPanel>
                  <Path DockPanel.Dock="Left" Data="M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 M7,3.5 L7,7.5 M7,9.5 L7,10.5" Stroke="#8C877C" StrokeThickness="1.1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock x:Name="urlText" Text="chrome://extensions" FontFamily="Segoe UI" FontSize="13" Foreground="#EBE6DA" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </Border>
          </StackPanel>

          <StackPanel x:Name="p3" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H}" Text="شغّل وضع المطوّر"/>
            <TextBlock Style="{StaticResource P}" Text="في صفحة الإضافات، شغّل مفتاح Developer mode اللي في زاوية الصفحة فوق."/>
            <TextBlock Style="{StaticResource Small}" Text="إذا متصفحك بالعربي، اسمه «وضع مطوّر البرامج»."/>
            <Border Style="{StaticResource Mock}" Margin="0,18,0,0">
              <DockPanel>
                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="10,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Developer mode" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Width="34" Height="18">
                      <Border Background="{StaticResource Gold}" CornerRadius="9"/>
                      <Ellipse Width="12" Height="12" Fill="#0E0E0F" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Path Data="M0,2 L4,2 L4,0 L8,0 L8,2 L12,2 L12,6 L14,6 L14,10 L12,10 L12,14 L0,14 Z" Stroke="#8C877C" StrokeThickness="1.1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Text="Extensions" FontSize="15" Foreground="#C9C4B8" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="p4" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H}" Text="حمّل الإضافة"/>
            <TextBlock Style="{StaticResource P}" Text="١. اضغط زر Load unpacked."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="٢. في نافذة اختيار المجلد اضغط" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Key}" FlowDirection="LeftToRight"><TextBlock Text="Ctrl + V" FontSize="12"/></Border>
              <TextBlock Text="في خانة Folder ثم اضغط Select Folder." VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Small}" Text="مسار المجلد انّسخ لك جاهز. بالعربي اسم الزر «تحميل إضافة تم فك حزمتها»."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="btnCopyPath" Style="{StaticResource Btn}" Content="انسخ المسار مرة ثانية"/>
              <TextBlock x:Name="copied4" Text="انّسخ" Foreground="#8FB184" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Hidden"/>
            </StackPanel>
            <Border Style="{StaticResource Mock}" Margin="0,16,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="12,5" Margin="0,0,8,0">
                    <TextBlock Text="Load unpacked" FontSize="12.5"/>
                  </Border>
                  <Border BorderBrush="#3A3833" BorderThickness="1" Padding="12,5" Margin="0,0,8,0">
                    <TextBlock Text="Pack extension" FontSize="12.5" Foreground="#7F7A70"/>
                  </Border>
                  <Border BorderBrush="#3A3833" BorderThickness="1" Padding="12,5">
                    <TextBlock Text="Update" FontSize="12.5" Foreground="#7F7A70"/>
                  </Border>
                </StackPanel>
                <DockPanel Margin="0,12,0,0">
                  <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="12,4" Margin="8,0,0,0">
                    <TextBlock Text="Select Folder" FontSize="12.5"/>
                  </Border>
                  <TextBlock DockPanel.Dock="Left" Text="Folder:" FontSize="12.5" Foreground="#9C968A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Border Background="#0A0A0B" BorderBrush="#3A3833" BorderThickness="1" Padding="8,4">
                    <TextBlock x:Name="pathText4" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource GoldHi}" TextTrimming="CharacterEllipsis"/>
                  </Border>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="p5" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H}" Text="جاهزة"/>
            <TextBlock Style="{StaticResource P}" Text="إذا ظهرت بطاقة «معنى» في صفحة الإضافات فالتثبيت تم."/>
            <TextBlock Style="{StaticResource P}" Text="صفحة الإعدادات تفتح لك تلقائيًا: اربط مفتاحك من Gemini أو غيره واضغط «اختبار»."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Style="{StaticResource Key}" FlowDirection="LeftToRight" Margin="0,0,6,0"><TextBlock Text="Alt + T" FontSize="12"/></Border>
              <TextBlock Text="ترجمة الصفحة" VerticalAlignment="Center" Margin="0,0,22,0"/>
              <Border Style="{StaticResource Key}" FlowDirection="LeftToRight" Margin="0,0,6,0"><TextBlock Text="Alt + M" FontSize="12"/></Border>
              <TextBlock Text="ترجمة صور المانجا" VerticalAlignment="Center"/>
            </StackPanel>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Small}" Text="ما ظهرت البطاقة؟ ارجع خطوة وتأكد إن وضع المطوّر شغّال، ثم اضغط Load unpacked مرة ثانية."/>
                <TextBlock Style="{StaticResource Small}" Text="للتحديث لاحقًا: شغّل المثبّت الجديد، ثم اضغط زر إعادة التحميل على بطاقة الإضافة."/>
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#0E0E0F">
        <DockPanel Margin="20,0">
          <Button x:Name="btnNext" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" MinWidth="128" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="nextText" Text="ابدأ التثبيت" VerticalAlignment="Center"/>
              <Path x:Name="nextArrow" Data="M0,0 L5,5 L0,10" Stroke="#0E0E0F" StrokeThickness="1.6" VerticalAlignment="Center" Margin="10,1,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="btnBack" DockPanel.Dock="Left" Style="{StaticResource Btn}" MinWidth="104" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Data="M5,0 L0,5 L5,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" VerticalAlignment="Center" Margin="0,1,10,0"/>
              <TextBlock Text="السابق" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="stepText" Foreground="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
